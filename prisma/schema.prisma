generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Analysis {
  id         String   @id @default(cuid())
  idea       String
  score      Int
  confidence String
  verdict    String
  result     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
